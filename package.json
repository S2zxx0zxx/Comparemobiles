{
  "name": "comparemobiles",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "data:validate": "tsx scripts/validate-preview.ts",
    "data:validate-import": "tsx scripts/validate-import.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply comparemobile --local",
    "db:migrate:remote": "wrangler d1 migrations apply comparemobile --remote",
    "db:seed:local": "wrangler d1 execute comparemobile --local --file=drizzle/seed/preview.sql"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@tanstack/react-table": "^9.0.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.5",
    "lucide-react": "^0.468.0",
    "motion": "13.4.0",
    "next": "16.3.8",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.2",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.17.0",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "4.3.0",
    "tsx": "4.23.15",
    "typescript": "^5.7.2",
    "vitest": "5.0.3",
    "wrangler": "4.143.0"
  }
}
